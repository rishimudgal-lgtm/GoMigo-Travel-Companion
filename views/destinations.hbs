<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#eaf8f0">
  <title>Destinations | GoMigo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=K2D:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="site.css">
  <script src="site.js" defer></script>
</head>
<body class="explore-page-theme public-explore-page">
  <header class="hero" id="top">
    <nav class="navbar" aria-label="Main navigation">
      <a class="brand" href="/"><img src="landing_assets/GoMigo-removebg-preview 1.svg" alt="GoMigo"></a>
      <div class="nav-links"><a href="/">Home</a><a href="/#how-it-works">Explore</a><a class="current" href="/destinations" aria-current="page">Destinations</a><a href="//travel-guide-preview">Travel Guide</a><a href="/login?next=/my-trips">My Trips</a></div>
      <div class="nav-actions"><a class="login" href="/login">Login</a><a class="nav-cta" href="/signup">Get Started</a></div>
    </nav>
    <div class="hero-copy">
      <h1>Explore Destinations</h1>
      <p class="hero-subtitle">Find your next adventure, discover new places, and plan a trip you’ll love.</p>
      <label class="search-box"><span aria-hidden="true">⌕</span><input id="destination-search" type="search" placeholder="Search destinations, cities or countries…" aria-label="Search destinations"><kbd>Ctrl K</kbd></label>
      <div class="filters" role="group" aria-label="Filter destinations">
        <button class="filter active" data-filter="all">Popular</button><button class="filter" data-filter="beach">Beach</button><button class="filter" data-filter="mountains">Mountains</button><button class="filter" data-filter="culture">Culture</button><button class="filter" data-filter="adventure">Adventure</button><button class="filter" data-filter="city">City</button>
      </div>
    </div>
    <a class="scroll-cue" href="#popular" aria-label="Scroll to popular destinations">↓</a>
  </header>

  <main>
    <section class="popular section-wrap" id="popular">
      <div class="section-heading"><div><p class="eyebrow green">A LITTLE INSPIRATION</p><h2>Popular destinations</h2><p class="section-subtitle">The places travellers can’t stop dreaming about.</p></div><a class="text-link" href="#trending">See what’s trending <span>↗</span></a></div>
      <div class="destination-grid" id="destination-grid">
        {{#each destinations}}
    <article class="destination-card" data-tags="{{this.category}}" data-search="{{this.name}} {{this.state}}">
      <img src="{{this.imageUrl}}" alt="{{this.name}}, {{this.state}}: destination photograph" loading="lazy" decoding="async" width="960" height="640">
      <span class="explore-place-name">{{this.name}}<small>{{this.state}} • ₹{{this.dailyBudgetInr}}/day</small></span>
      <a class="destination-hitarea" href="/trip-planner?destination={{this.name}}" aria-label="Plan a trip to {{this.name}}"></a>
      <button class="save-destination" type="button" data-favorite-toggle data-destination="{{this.name}}" aria-label="Save {{this.name}}" aria-pressed="false">♡</button>
    </article>
  {{/each}}
      </div>
      <div class="explore-more-wrap">
        <button class="explore-more-button" id="explore-more" type="button" hidden>Explore more <span aria-hidden="true">↓</span></button>
        <p id="explore-progress" aria-live="polite"></p>
      </div>
      <p class="empty-state" id="empty-state" hidden>No destinations match that search. Try a different place or category.</p>
    </section>

    <section class="planner-banner section-wrap">
      <a class="banner-image-link" href="/trip-planner" aria-label="Plan a trip with GoMigo"><img src="explore_assets/openwithAI.png" alt="Not sure where to go? Let GoMigo find your perfect destination. Plan with AI."></a>
    </section>

    <section class="inspiration section-wrap" id="trending">
      <div class="section-heading"><div><p class="eyebrow green">MADE FOR YOUR MOOD</p><h2>Explore by travel style</h2><p class="section-subtitle">Find a place that feels like you.</p></div></div>
      <div class="style-grid">
        <a class="style-card" href="#popular" data-style="beach"><img src="explore_assets/beach.png" alt="Beach Escapes"></a>
        <a class="style-card" href="#popular" data-style="mountains"><img src="explore_assets/mountain.png" alt="Mountain Adventures"></a>
        <a class="style-card" href="#popular" data-style="culture"><img src="explore_assets/culture.png" alt="Cultural Getaways"></a>
        <a class="style-card" href="#popular" data-style="adventure"><img src="explore_assets/dining.png" alt="Food and Dining"></a>
        <a class="style-card adventure" href="#popular" data-style="adventure"><img src="explore_assets/adventure.png" alt="Adventure Trips"></a>
      </div>
    </section>
    <section class="trending section-wrap">
      <div class="section-heading"><div><p class="eyebrow green">ON EVERYONE’S LIST</p><h2>Trending right now</h2><p class="section-subtitle">Destinations everyone’s talking about.</p></div><a class="text-link" href="/destinations">Explore all destinations <span>↗</span></a></div>
      <div class="trending-grid">
        <a href="/trip-planner"><img src="explore_assets/japan.png" alt="Japan"></a>
        <a href="/trip-planner"><img src="explore_assets/greece.png" alt="Greece"></a>
        <a href="/trip-planner"><img src="explore_assets/canada.png" alt="Canada"></a>
        <a href="/trip-planner"><img src="explore_assets/iceland.png" alt="Iceland"></a>
        <a href="/trip-planner"><img src="explore_assets/portugal.png" alt="Portugal"></a>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="footer-columns">
      <section class="footer-group">
        <h2><span>for</span> Travellers</h2>
        <a href="/trip-planner">Plan Your Trip</a>
        <a href="/destinations">Explore Destinations</a>
        <a href="/destinations#trending">Find Experiences</a>
        <a href="//travel-guide-preview">Travel Tips</a>
        <a href="#help">Help</a>
      </section>
      <div class="footer-middle">
        <section class="footer-group">
          <h2><span>for</span> Creators</h2>
          <a href="#become-creator">Become a Creator</a>
          <a href="#creator-academy">Creator Academy</a>
        </section>
        <section class="footer-group business-group">
          <h2><span>for</span> Business</h2>
          <a href="#business">Overview</a>
          <a href="/destinations">Destinations</a>
          <a href="#hotels">Hotels</a>
          <a href="#how-it-works">How It Works</a>
          <a href="#packages">Packages*</a>
          <a href="#book-a-demo">Book a demo</a>
        </section>
      </div>
      <section class="footer-group">
        <h2><span>for</span> Company</h2>
        <a href="#about">About</a>
        <a href="#team">Team</a>
        <a href="#press">Press</a>
        <a href="#media-kit">Media Kit</a>
        <a href="#contact">Contact</a>
        <a href="#resources">Resources</a>
        <a href="#mindtrip-app">Mindtrip App</a>
      </section>
    </div>
    <nav class="footer-socials" aria-label="Social media">
      <a class="instagram" href="#instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="social-dot" cx="18" cy="6" r="1"/></svg></a>
      <a class="facebook" href="#facebook" aria-label="Facebook"><span aria-hidden="true">f</span></a>
      <a class="x-social" href="#x" aria-label="X"><span aria-hidden="true">𝕏</span></a>
      <a class="youtube" href="#youtube" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg></a>
      <a class="linkedin" href="#linkedin" aria-label="LinkedIn"><span aria-hidden="true">in</span></a>
    </nav>
  </footer>
</body>
</html>
